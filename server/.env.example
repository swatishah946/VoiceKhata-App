# Copy to server/.env for local development. NEVER commit the real .env.
# The server refuses to start if a required value is missing or too weak.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:password@localhost:5432/voicekhata_app
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- AI ----------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GROQ_API_KEY=
# Below this confidence the review screen shows "please check every number"
AI_MIN_CONFIDENCE=0.6
# Warn on the review screen if the spoken rate differs from the price list by more than this %
PRICE_VARIANCE_WARN_PCT=10

# --- Queue -------------------------------------------------------------------
# Redis URL (Upstash: use the rediss:// one), or leave empty for REDIS_HOST/REDIS_PORT (docker-compose uses 6380)
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# --- Other -------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Only the browser preview needs this (the phone app sends no Origin header)
CORS_ORIGINS=http://localhost:8081
# Tests use ONLY this (never DATABASE_URL). The database name must contain "test".
TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/voicekhata_test
